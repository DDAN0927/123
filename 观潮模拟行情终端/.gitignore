# 依赖
node_modules/

# 临时文件与日志
_tmp/
*.log
npm-debug.log*

# 测试产物
test-results/
playwright-report/
coverage/

# 本地密钥（wrangler 本地开发用，绝不可提交）
.dev.vars
.env
.env.*
.wrangler/

# 评估交付物（报告为过程产物，不进版本库）
deliverables/

# 工作区元数据
.workbuddy-ai/
.workbuddy/

# 发布镜像与部署标记(site-release 与 index.html 内容重复,部署时由脚本生成)
site-release/
.wbapp_*.genie

# 系统文件
Thumbs.db
desktop.ini
.DS_Store

# 评估过程产物（截图、探针脚本、本地依赖）
deliverables/

# 删除前的备份包（含旧后端代码，勿提交）
_backup/

# Python（后端）
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 后端一致性基准（体积大且可由脚本重生成：node backend/tests/parity_gen.js）
backend/tests/parity_*.json
