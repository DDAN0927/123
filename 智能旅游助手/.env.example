# ================= LLM 配置 =================
# openai: 任意 OpenAI 兼容接口（vLLM 本地部署 / 智谱 / DeepSeek / 通义 等）
# mock:   无模型演示模式（不调用任何 LLM，用于跑通流程）
LLM_PROVIDER=openai

# OpenAI 兼容接口地址，常见取值：
#   vLLM 本地:        http://localhost:8000/v1
#   智谱 GLM:         https://open.bigmodel.cn/api/paas/v4
#   DeepSeek:         https://api.deepseek.com/v1
#   通义千问:          https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.7
# 快速模型：只用于调度路由与工具调用（temperature 固定 0.1，与上面的主模型分开）。
# 留空 = 复用 LLM_MODEL。若主模型是思考类模型（如 deepseek-reasoner），
# **必须单独配一个普通对话模型**：思考模型不支持 function calling，
# 留空会让工具调用静默失效（不报错，只是永远不调工具）。
LLM_ROUTER_MODEL=

# ================= Embedding / RAG =================
# BGE 中文向量模型（CPU 可跑；国内下载慢可设置环境变量 HF_ENDPOINT=https://hf-mirror.com）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=4
# 相关度下限：低于此值的检索结果直接丢弃，避免噪声查询污染提示词。
# 实测噪声查询（「你好」「帮我订个机票」）最高分在 0.40~0.51，
# 真实查询普遍 0.68 以上，0.55 是能干净分开两者的分界。
# ⚠️ 改过知识库语料后必须跑 scripts/eval_rag.py 重新校准，否则会误杀有效结果。
RETRIEVAL_MIN_SCORE=0.55

# ================= 路径（容器 / 云部署时按需覆盖） =================
# 数据目录：SQLite（travel.db）、会话、反馈、FAISS 索引全在这一个目录下。
# 容器里必须挂到持久卷，否则重建即丢全部账号与会话。
# DATA_DIR=/app/data
# 知识库目录：放 .md / .txt 攻略，重建索引时从这里读取。
# KB_DIR=/app/knowledge_base

# ================= Agent =================
# 单次提问最多路由的专家次数（防止死循环）
MAX_AGENT_STEPS=4

# ================= 高德地图（可选） =================
# 在 lbs.amap.com 申请，Key 类型选「Web端(JS API)」，创建时会同时给出安全密钥 jscode。
# 两者由后端 GET /api/config 下发给前端（前端源码里不再硬编码）。
#
# 关于安全：这两个值**本来就要发送到浏览器**（JS API 2.0 强制要求在建图前注入
# window._AMapSecurityConfig），所以它们不是服务端密钥；真正的访问控制靠高德控制台的
# **域名白名单**。
#
# 留空/注释掉 = 使用项目内置的演示 Key（够跑通演示，但流量记在演示 Key 上）。
# 正式部署请换成自己的 Key，否则你的访问量会消耗演示 Key 的额度。
# ⚠️ 若在控制台配置过域名白名单，部署到新域名后必须把新域名加进去，否则地图会加载失败。
# AMAP_KEY=
# AMAP_SECURITY_JS_CODE=

# ================= 管理员账号 =================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 登录态有效期（秒）。默认 7 天，过期需重新登录。
# 早期实现里 token 是永久有效的 —— 一旦泄露无法自行失效，属于真实安全问题。
TOKEN_TTL_SECONDS=604800

# ================= LLM 成本估算（只影响运营看板，不影响实际扣费） =================
# 单价：元 / 百万 tokens。双模型架构下两档价格差 2~4 倍，必须按模型分开计价，
# 否则路由调用会被按推理模型计价，看板上的成本会明显偏高。
# 默认取 DeepSeek 公开价（reasoner 4/16，chat 2/8），请以服务商当期价目为准。
LLM_PRICE_INPUT_PER_MTOK=4.0
LLM_PRICE_OUTPUT_PER_MTOK=16.0
LLM_PRICE_CHAT_INPUT_PER_MTOK=2.0
LLM_PRICE_CHAT_OUTPUT_PER_MTOK=8.0

# ================= 注册开关 =================
# true  任何人可自助注册（开放体验；此时下面的限流就是唯一的额度防线）
# false 关闭开放注册，新账号由管理员在「运营管理」页开通（收紧选项）
ALLOW_REGISTRATION=false

# ================= 限流（保护真实 LLM 额度） =================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_MINUTE=2   # 匿名访客：每个 IP 每分钟
RATE_LIMIT_PER_MINUTE=6             # 登录用户：每个 IP 每分钟
RATE_LIMIT_GLOBAL_PER_MINUTE=20     # 全局硬上限（伪造 X-Forwarded-For 也绕不过）
AUTH_RATE_LIMIT_PER_MINUTE=10       # 登录 / 注册：每个 IP 每分钟
# 部署在反向代理后面时置 true，从 X-Forwarded-For 取真实客户端 IP
TRUST_PROXY_HEADERS=true
