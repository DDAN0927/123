# ================= LLM 配置 =================
# openai: 任意 OpenAI 兼容接口（vLLM 本地部署 / 智谱 / DeepSeek / 通义 等）
# mock:   无模型演示模式（不调用任何 LLM，用于跑通流程）
LLM_PROVIDER=openai

# OpenAI 兼容接口地址，常见取值：
#   vLLM 本地:        http://localhost:8000/v1
#   智谱 GLM:         https://open.bigmodel.cn/api/paas/v4
#   DeepSeek:         https://api.deepseek.com/v1
#   通义千问:          https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.7

# ================= Embedding / RAG =================
# BGE 中文向量模型（CPU 可跑；国内下载慢可设置环境变量 HF_ENDPOINT=https://hf-mirror.com）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=4

# ================= Agent =================
# 单次提问最多路由的专家次数（防止死循环）
MAX_AGENT_STEPS=4

# ================= 高德地图（可选） =================
# 在 lbs.amap.com 申请，Key 类型选「Web端(JS API)」，创建时会同时给出安全密钥 jscode。
# 两者由后端 GET /api/config 下发给前端（前端源码里不再硬编码）。
#
# 关于安全：这两个值**本来就要发送到浏览器**（JS API 2.0 强制要求在建图前注入
# window._AMapSecurityConfig），所以它们不是服务端密钥；真正的访问控制靠高德控制台的
# **域名白名单**。
#
# 留空/注释掉 = 使用项目内置的演示 Key（够跑通演示，但流量记在演示 Key 上）。
# 正式部署请换成自己的 Key，否则你的访问量会消耗演示 Key 的额度。
# ⚠️ 若在控制台配置过域名白名单，部署到新域名后必须把新域名加进去，否则地图会加载失败。
# AMAP_KEY=
# AMAP_SECURITY_JS_CODE=

# ================= 管理员账号 =================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ================= 注册开关 =================
# true  任何人可自助注册（开放体验；此时下面的限流就是唯一的额度防线）
# false 关闭开放注册，新账号由管理员在「运营管理」页开通（收紧选项）
ALLOW_REGISTRATION=false

# ================= 限流（保护真实 LLM 额度） =================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_MINUTE=2   # 匿名访客：每个 IP 每分钟
RATE_LIMIT_PER_MINUTE=6             # 登录用户：每个 IP 每分钟
RATE_LIMIT_GLOBAL_PER_MINUTE=20     # 全局硬上限（伪造 X-Forwarded-For 也绕不过）
AUTH_RATE_LIMIT_PER_MINUTE=10       # 登录 / 注册：每个 IP 每分钟
# 部署在反向代理后面时置 true，从 X-Forwarded-For 取真实客户端 IP
TRUST_PROXY_HEADERS=true
